{
  "name": "jarvis-excel-agent",
  "version": "1.0.0",
  "description": "J.A.R.V.I.S. - AI Excel & Student Database Agent Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-win-portable": "electron-builder --win portable"
  },
  "author": "J.A.R.V.I.S. Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {},
  "build": {
    "appId": "com.jarvis.excelagent",
    "productName": "J.A.R.V.I.S. Excel Agent",
    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon.ico",
      "publisherName": "J.A.R.V.I.S."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
